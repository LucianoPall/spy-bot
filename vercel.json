{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["sfo1"],
  "functions": {
    "src/app/api/**": {
      "maxDuration": 30,
      "memory": 3008
    },
    "src/app/api/internal/batch-scrape/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/internal/daily-report",
      "schedule": "0 12 * * *"
    }
  ]
}
